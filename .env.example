# PrudenTia web — environment
#
# VITE_API_URL is a BUILD-TIME variable. Vite inlines `import.meta.env` into the bundle;
# it is NOT read at runtime. In the Azure Static Web Apps deployment it must therefore be
# present in the GitHub Actions workflow `env:` block, not only in the portal — set it in
# the portal alone and the built bundle calls localhost in production.
#
# No trailing slash.
VITE_API_URL=http://localhost:8080
